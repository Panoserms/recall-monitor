.venv/
__pycache__/
*.egg-info/
.pytest_cache/

# Raw notices and the database stay on this machine.
# The portal's terms of use ask that republished notices are complete, unchanged,
# carry a source line and are deleted once the portal removes them, so they are
# not committed. Run `recall fetch` to get your own copy.
data/raw/
data/*.db
data/*.db-wal
data/*.db-shm
data/export/

# Your own product list is private. The example list is committed.
data/my_products.csv

# Hand labels are yours; the template (no labels) is generated by `recall eval --template`.
data/gold.csv
data/gold_template.csv

# The built website (recall build-site); published by the GitHub workflow, not committed.
public/

# Receipt evaluation output: built from private receipts, stays on this machine.
data/receipt_eval/

# Node packages for the browser checks (tools/) and the story video (motion/).
node_modules/

# Screenshots of built pages (they show notice text, which is not republished from git).
data/screens/

# The video project keeps its fonts in motion/public (not the built site).
!motion/public/

.DS_Store
